APP_NAME=ComptoFlow
APP_ENV=production
APP_KEY=
# IMPORTANT : ne jamais mettre APP_DEBUG=true en production.
# Une exception non gérée afficherait alors la stack trace complète,
# les requêtes SQL exécutées (avec leurs valeurs), et les chemins serveur.
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_TIMEZONE=Africa/Abidjan

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=comptoflow
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Mettre à true en production si le site est servi en HTTPS, pour que
# le cookie de session ne soit jamais transmis en clair sur HTTP.
SESSION_SECURE_COOKIE=false

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@comptoflow.ci"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ── IA intégrée (suggestion de comptes comptables) ────────────
# Créer une clé sur https://console.anthropic.com
ANTHROPIC_API_KEY=
